DATABASE_URL=postgres://starling:starling@localhost:5432/starling
GIPHY_API_KEY=

# ── Outgoing mail ─────────────────────────────────────────────────────────────
# Production: the Plesk mailbox that sends notifications. In development leave
# SMTP_HOST empty to log emails to the console, or point it at Mailpit
# (docker compose up mailpit) on localhost:1025.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on port 465
SMTP_SECURE=false
SMTP_USER=no-reply@cino.no
SMTP_PASS=
# Only for a local MTA reached as "localhost", whose certificate never matches.
SMTP_ALLOW_INSECURE_TLS=false
MAIL_FROM="Starling <no-reply@cino.no>"

# Public origin of the web app — every link inside an email is built from it.
APP_URL=http://localhost:5173
