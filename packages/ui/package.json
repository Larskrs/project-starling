{
  "name": "@starling/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build-icons": "node scripts/build-icons.mjs",
    "build": "npm run build-icons && vite build && vue-tsc --emitDeclarationOnly -p tsconfig.json",
    "dev": "npm run build-icons && vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css",
    "./tailwind-preset": "./tailwind-preset.js",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "@iconify/vue": "^5.0.0",
    "radix-vue": "^1.0.0",
    "vue": "^3.0.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "vue-tsc": "^2.2.12"
  }
}
